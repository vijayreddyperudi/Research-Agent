# Environment Configuration for Enterprise AI Research Agent

# OpenAI API Key (Required for live LLM planning, synthesis, and report generation)
OPENAI_API_KEY=your_openai_api_key_here

# Default Model configuration
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# Agent Execution Limits
MAX_RESEARCH_ROUNDS=3
MIN_USEFUL_SOURCES=5

# Internal Docs Path
INTERNAL_DOCS_PATH=./data/internal_docs

# API and Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

